\section{Métodos modernos}

\subsection{Estandarización y fórmula G}


\subsection{IPTW}
% TODO: cite
El método IPTW, del inglés \say{Inverse Probability of Treatment Weighting}, consiste en,
en vez de estimar un modelo del resultado
($\E[Y | A, X]$), estimar la propensidad al tratamiento dadas las covariantes.

\begin{definicion}[Propensidad al tratamiento]
    Definimos la propensidad al tratamiento o, por brevedad, propensidad, como la siguiente cantidad:
    \[
        e(x) = P(A = 1| X = x)
    \]
\end{definicion}

\begin{proposicion}[Equivalencia entre IPW y g-computación]
    Bajo positividad (\autoref{def:positivity}) se verifican:
    \begin{align*}
        E\left[\frac{A Y}{e(X)}\right]           & = E[E[Y | A = 1, X]] = \sum_x \mu_1(x) P(X = x) \\
        E\left[\frac{(1 - A) Y}{1 - e(X)}\right] & = E[E[Y | A = 0, X]] = \sum_x \mu_0(x) P(X = x)
    \end{align*}
\end{proposicion}

\begin{proof}\cite[Technical point 2.3]{whatif}
    Usando que el producto se anula para $a = 0$:
    \begin{align*}
        \E\left[\frac{A Y}{e(X)}\right]
         & = \sum_{x, a, y} \frac{a y}{e(x)} P(Y = y, A = a, X = x)                       \\
         & = \sum_{x, y} \frac{y}{e(x)} P(Y = y, A = 1, X = x)                            \\
         & = \sum_{x, y} \frac{y}{e(x)} P(Y = y | A = 1, X = x) P(A = 1 | X = x) P(X = x) \\
         & = \sum_x P(X = x) \sum_y y P(Y = y | A = 1, X = x)                             \\
         & = \sum_x P(X = x) \mu_1(x) = \E_X[\E[Y | A = 1, X]]
    \end{align*}

    donde las sumas en $x$ toman los valores con $P(X = x) > 0$, en los cuales
    $e(x) = P(A = 1 | X = x) > 0$ por la positividad.

    El caso para $\frac{(1-A)Y}{1 - e(X)}$ es análogo.
\end{proof}

\begin{corolario}
    Recordando la demostración de la identificación del ATE, \autoref{prop:identificacion-ate},
    tenemos que si además se da la intercambiabilidad condicional y la consistencia
    (\autoref{def:intercambiabilidad}, \autoref{def:consistency}),
    $\E\left[\frac{A Y}{e(X)}\right]$ está identificada con $E[Y(1)]$
    y
    $\frac{(1-A)Y}{1- e(X)}$ con $E[Y(0)]$.
\end{corolario}

\begin{corolario}[Estimación del ATE por IPTW] \label{cor:ate-ipwt}
    Bajo las condiciones del corolario, tenemos que:
    \[
        ATE = E\left[\frac{AY}{e(X)}\right] - E\left[\frac{(1-A) Y}{1-e(X)}\right]
    \]
    Igualdad de la cual se derivan varios estimadores.
\end{corolario}

\begin{observacion}
    Teniendo una propensidad conocida, tendríamos estimadores insesgados (tomando la esperanza en
    \autoref{cor:ate-ipwt}). Para propensidades aproximadas, tenemos insesgadez asintótica
    sujeto a que la propensidad estimada converja a la propensidad real. Eso es, que el
    modelo de la propensidad esté bien especificado.
    %\footnotemark{}. % TODO:
    %\footnotetext{Consideramos, generalmente, modelos topológicamente cerrados.}
\end{observacion}

\begin{definicion}[Estimador de Horvitz-Thompson] \cite[Technical Point 12.1]{whatif}
    Estimando $e$ por $\hat e$ y sustituyendo esperanzas por medias, obtenemos
    \[
        \hat \psi_{HT} = \frac{1}{n} \sum_{i = 1}^n
        \left(
        \frac{A_i Y_i}{\hat e(X_i)} - \frac{(1 - A_i) Y_i}{1- \hat e(X_i)}
        \right)
    \]
\end{definicion}

\begin{definicion}[Estimador de Hájek] \cite[Technical Point 12.1]{whatif}
    Dividiendo cada lado por
    \[
        \hat \psi_{Hajek} =
        \frac{
            \sum_{i = 1}^n \frac{A_i Y_i}{\hat e(X_i)}
        }{
            \sum_{i = 1}^n \frac{A_i}{\hat e(X_i)}
        }
        -
        \frac{
            \sum_{i = 1}^n \frac{(1 - A_i) Y_i}{1- \hat e(X_i)}
        }{
            \sum_{i = 1}^n \frac{1 - A_i}{1- \hat e(X_i)}
        }
    \]
\end{definicion}

\subsection{AIPW}
Del inglés \say{Augmented Inverse Probability Weighting}.
Este método utiliza la estandarización y el método IPTW simultáneamente para obtener
una estimación \emph{doblemente robusta}.

\begin{definicion}[Estimador AIPW] \cite[Technical Point 13.3]{whatif} \cite[5.2]{luque2021}
	Sea $\hat \mu_a(x)$ un estimador de $E[Y | A = a, X = x]$ y $\hat e(x)$ un
	estimador de $P(A = 1 | X = x)$.
	\[
	    \hat \psi_{AIPW} = \frac{1}{n} \sum_{i = 1}^n
	    \left(
	    \frac{A_i (Y_i - \hat \mu_1(X_i))}{\hat e(X_i)}
	    - \frac{(1 - A_i) (Y_i - \hat \mu_0(X_i))}{1 - \hat e(X_i)}
	    + \hat \mu_1(X_i) - \hat \mu_0(X_i)
	    \right)
	\]
\end{definicion}
