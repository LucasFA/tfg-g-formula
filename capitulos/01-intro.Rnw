    Usando una muestra de tamaño grande observamos que el ATE de $X$ en $Y$ es
    casi nulo en cada estrato, como esperamos por la definición de las variables.
\end{ejemplo}

\begin{definicion}[Modelo estructural causal]
    \cite[sección 1.2]{mci}
    Dado un vector aleatorio
    $(X_1, \ldots, X_n)$, factorizando su función de distribución como
    $P(X_1, \ldots, X_n) = P(X_1) \prod_{i=2} P(X_i | PA_i)$,
    modelamos con el siguiente sistema de ecuaciones:
    \begin{align*}
        X_1 & = f_1(U_1)                         \\
        X_i & = f_i(PA_i, U_i), i = 2, \ldots, n
    \end{align*}
    donde $U_i, \, i = 1, \ldots, n$ son variables exógenas.
\end{definicion}

% TODO: is this proper notation? with the mathcal
\begin{definicion}[Efecto causal]\cite[Def. 3.2.1]{pearl2009causality}
    Dado un modelo estructural de ecuaciones $\mathcal{M}$, y dos conjuntos
    disjuntos de variables $X$ e $Y$, se  define
    $P(Y = y | do(X = x)) \equiv P(y | do(x))$
    como la probabilidad $P(y)$ en el modelo $\mathcal{M}\~{}$ obtenido
    de eliminar las ecuaciones que dan como resultado variables en $X$
    y tomando en el resto de ecuaciones los valores $X = x$.
\end{definicion}
Esto efectivamente elimina las aristas dirigidas hacia los nodos de $X$.

\begin{ejemplo}\cite[sección 1.2]{mci}
    Supongamos que tenemos unas covariantes $X$, un tratamiento $A$ y un resultado $Y$, y
    consideramos el modelo estructural
    \begin{align*}
        X                      & = U_X              \\
        A                      & = f_A(X, U_A)      \\
        Y                      & = f_Y(X, A, U_Y)   \\
        \operatorname{Im}(f_A) & \subseteq \{0, 1\}
    \end{align*}
    Omitiendo las variables exógenas $U = \left(U_X, U_A, U_Y\right)$, nos queda el diagrama causal
    visto en la \autoref{subfig:observacional}, correspondiente a un estudio observacional.
    Si fijamos la distribución de $A$, por ejemplo a una $B(1, 1/2)$, eliminamos
    su dependencia en $X$ y obtenemos el diagrama causal de la \autoref{subfig:cd-rct},
    de un estudio randomizado controlado.
\end{ejemplo}
