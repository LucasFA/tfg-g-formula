Esta sección se basa en \emph{Causality}, por Judea Pearl, ver \cite{pearl2009causality}.

\begin{definicion}[Padres Markovianos]\cite[1.2.1]{pearl2009causality}.
    Sea $(X_1, \ldots, X_n)$ un vector aleatorio con distribución conjunta $P$.
    Se dice que una familia $PA_i \subseteq \{X_1, \ldots, X_{i-1}\}$ forma el conjunto
    de los padres Markovianos de
    $X_i$ si $P(X_i | PA_i) = P(X_i | X_1, \ldots X_{i-1})$, y esta familia es minimal
    satisfaciendo esta propiedad.
\end{definicion}

